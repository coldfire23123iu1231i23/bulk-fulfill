# ==== Shopify ====
# Domain .myshopify.com cua store (KHONG co https://)
SHOPIFY_SHOP=b8t7nn-dr.myshopify.com
# Admin API access token cua Custom App (bat dau bang shpat_)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Version API - de nguyen neu khong biet
SHOPIFY_API_VERSION=2026-07

# ==== Bao mat app ====
# Mat khau de dang nhap vao app (tu dat, dat manh vao)
APP_PASSWORD=doi-mat-khau-nay-di

# ==== Tuy chon ====
# Mac dinh co gui email bao van chuyen cho khach khong (true/false)
DEFAULT_NOTIFY_CUSTOMER=true
PORT=3000

# ==== Embedded app trong Shopify Admin (tuy chon) ====
# Lay o Partner Dashboard > app cua anh > Client credentials
SHOPIFY_API_KEY=client_id_cua_app
SHOPIFY_API_SECRET=client_secret_cua_app
